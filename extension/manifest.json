{
  "manifest_version": 3,
  "name": "JMI Job Saver",
  "version": "0.1.0",
  "description": "Save job postings to your local JMI backend via HITL ingestion (ADR-0009).",
  "permissions": [
    "storage",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": [
    "https://justjoin.it/*",
    "https://nofluffjobs.com/*",
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": []
}
