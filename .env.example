# Copy to `.env` and adjust. `.env` is gitignored.

# Postgres
POSTGRES_USER=jmi
POSTGRES_PASSWORD=jmi_dev_password
POSTGRES_DB=jmi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://jmi:jmi_dev_password@127.0.0.1:5432/jmi
# Use 127.0.0.1 not localhost — on Windows, psycopg v3 tries IPv6 first and
# Docker Desktop binds the container port to IPv4 only, so "localhost" hangs.

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# LLM (weekend — leave empty today)
ANTHROPIC_API_KEY=
